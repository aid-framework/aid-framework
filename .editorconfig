# EditorConfig — cross-language defaults for the AID Framework monorepo.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{py,pyi}]
indent_size = 4

[*.{java,kt,kts,groovy}]
indent_size = 4

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,graphql}]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2

[*.sln]
indent_style = tab

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
