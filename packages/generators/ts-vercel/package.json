{
  "name": "@aid-framework/generator-ts-vercel",
  "version": "0.1.51",
  "description": "AID generator for a Next.js App Router (Vercel) TypeScript target.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aid-framework/aid-framework.git",
    "directory": "packages/generators/ts-vercel"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@aid-framework/generator-sdk": "workspace:*",
    "@aid-framework/ir": "workspace:*"
  },
  "devDependencies": {
    "@aid-framework/spec": "workspace:*",
    "@types/node": "^26.6.5"
  }
}
