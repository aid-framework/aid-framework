  "pipelines": [
    {
      "description": "Triage an inbound ticket and post the refund decision.",
      "errorPolicy": {
        "retries": 0
      },
      "id": "handle_ticket",
      "identity": "pipeline:handle_ticket",
      "observability": {
        "redact": [],
        "trace": true
      },
      "steps": [
        {
          "as": "classification",
          "input": {
            "body": {
              "kind": "reference",
              "path": [
                "event",
                "body"
              ]
            },
            "subject": {
              "kind": "reference",
              "path": [
                "event",
                "subject"
              ]
            }
          },
          "kind": "generate",
          "model": "triage",
          "prompt": "classify_ticket"
        },
        {
          "as": "refund",
          "input": {
            "amount_usd": {
              "kind": "literal",
              "value": 42.5
            },
            "order_id": {
              "kind": "reference",
              "path": [
                "event",
                "order_id"
              ]
            },
            "reason": {
              "kind": "reference",
              "path": [
                "classification",
                "summary"
              ]
            }
          },
          "kind": "tool",
          "tool": "issue_refund"
        },
        {
          "event": "TicketEvent",
          "kind": "emit"
        }
      ],
      "trigger": {
        "kind": "http",
        "method": "post",
        "path": "/tickets/{ticket_id}"
      }
    }
  ],
