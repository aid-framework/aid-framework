{
  "name": "@aid/cli",
  "version": "0.0.0",
  "description": "The `aid` command: scaffold a project, validate its spec, generate its code, and run its eval gate.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aid": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@aid/generator-py-fastapi": "workspace:*",
    "@aid/generator-sdk": "workspace:*",
    "@aid/ir": "workspace:*",
    "@aid/spec": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3"
  }
}
