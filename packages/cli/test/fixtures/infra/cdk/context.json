{
  "project": { "name": "ping", "namespace": "aid.test" },
  "services": {
    "api": {
      "target": "serverless",
      "streaming": false,
      "routes": [{ "pipeline": "ping", "method": "GET", "path": "/ping" }],
      "env": [
        { "name": "LOG_LEVEL", "secret": false, "from": "spec", "value": "info" },
        { "name": "OPENAI_API_KEY", "secret": true, "from": "deployment" }
      ],
      "secrets": ["OPENAI_API_KEY"],
      "providers": ["bedrock"],
      "ingest": []
    }
  },
  "stores": {},
  "tasks": [],
  "alarms": []
}
