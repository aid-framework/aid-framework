{
  "project": { "name": "ping", "namespace": "aid.test" },
  "services": {
    "api": {
      "target": "serverless",
      "streaming": false,
      "routes": [{ "pipeline": "ping", "method": "GET", "path": "/ping" }],
      "env": [
        { "name": "LOG_LEVEL", "secret": false, "from": "spec", "value": "info" },
        { "name": "OPENAI_API_KEY", "secret": true, "from": "deployment" }
      ],
      "secrets": ["OPENAI_API_KEY"],
      "providers": ["bedrock"],
      "ingest": ["docs"],
      "guardrailEngines": ["bedrock"]
    },
    "worker": {
      "target": "container",
      "streaming": true,
      "routes": [
        { "pipeline": "chat", "method": "POST", "path": "/chat/*" },
        { "pipeline": "chat", "method": "POST", "path": "/chat" }
      ],
      "env": [
        { "name": "LOG_LEVEL", "secret": false, "from": "spec", "value": "debug" },
        { "name": "OPENAI_API_KEY", "secret": true, "from": "deployment" }
      ],
      "secrets": ["OPENAI_API_KEY"],
      "providers": ["bedrock"],
      "ingest": ["docs"],
      "guardrailEngines": []
    },
    "nightly": {
      "target": "batch",
      "streaming": false,
      "pipeline": "ping",
      "routes": [],
      "env": [
        { "name": "LOG_LEVEL", "secret": false, "from": "spec", "value": "info" }
      ],
      "secrets": [],
      "providers": ["bedrock"],
      "ingest": ["docs"],
      "guardrailEngines": []
    },
    "edge": {
      "target": "edge",
      "streaming": false,
      "routes": [{ "pipeline": "ping", "method": "GET", "path": "/edge/ping" }],
      "env": [
        { "name": "LOG_LEVEL", "secret": false, "from": "spec", "value": "info" }
      ],
      "secrets": [],
      "providers": ["bedrock"],
      "ingest": [],
      "guardrailEngines": []
    }
  },
  "guardrails": {
    "api": {
      "id": "api",
      "message": "I can't help with that.",
      "content": [{ "type": "HATE", "strength": "HIGH" }],
      "topics": [{ "name": "medical-advice", "definition": "Advice about a medical condition." }],
      "words": ["forbidden-term"],
      "pii": [{ "type": "EMAIL", "action": "BLOCK" }]
    }
  },
  "knowledgeBases": {
    "handbook": {
      "id": "",
      "arn": "",
      "engine": "aws-bedrock",
      "dataSource": { "kind": "s3", "uri": "s3://aid-corpus/handbook/" },
      "chunking": { "strategy": "fixed", "size": 300, "overlap": 30 },
      "embedModel": "titan-embed-v2",
      "embedModelId": "amazon.titan-embed-text-v2:0",
      "envName": "BEDROCK_KNOWLEDGE_BASE_HANDBOOK",
      "filterable": [],
      "vectorStore": { "kind": "provisioned" },
      "retrievers": ["docs"]
    }
  },
  "stores": {},
  "tasks": [],
  "alarms": []
}
